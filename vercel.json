{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth?action=protected-resource" },
    { "source": "/.well-known/oauth-protected-resource/:path*", "destination": "/api/oauth?action=protected-resource" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth?action=authorization-server" },
    { "source": "/.well-known/oauth-authorization-server/:path*", "destination": "/api/oauth?action=authorization-server" },
    { "source": "/oauth/register", "destination": "/api/oauth?action=register" },
    { "source": "/oauth/authorize", "destination": "/api/oauth?action=authorize" },
    { "source": "/oauth/token", "destination": "/api/oauth?action=token" }
  ]
}
