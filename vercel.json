{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "/", "dest": "/api/index" },
    { "src": "/\\.well-known/oauth-protected-resource(?:/.*)?", "dest": "/api/oauth?action=protected-resource" },
    { "src": "/\\.well-known/oauth-authorization-server(?:/.*)?", "dest": "/api/oauth?action=authorization-server" },
    { "src": "/oauth/register", "dest": "/api/oauth?action=register" },
    { "src": "/oauth/authorize", "dest": "/api/oauth?action=authorize" },
    { "src": "/oauth/token", "dest": "/api/oauth?action=token" }
  ]
}
